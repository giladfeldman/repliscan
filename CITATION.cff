cff-version: 1.2.0
message: "If you use this software, please cite it as below."
title: "repliscan: replication-study discovery and classification"
type: software
authors:
  - family-names: Feldman
    given-names: Gilad
    affiliation: University of Innsbruck
version: "0.2.0"
license: MIT
repository-code: "https://github.com/giladfeldman/repliscan"
abstract: >-
  A TypeScript library for finding replication studies in the academic literature:
  OR-bundled phrase search across OpenAlex, Crossref and Semantic Scholar, deterministic
  keyword expansion, exclusion and ranking, a multi-provider metadata resolver, and a
  deterministic rule-based replication classifier with a reference-list back-check.
keywords:
  - replication
  - meta-science
  - open science
  - research integrity
  - OpenAlex
  - Crossref
references:
  - type: dataset
    title: "FReD: the FORRT Replication Database"
    authors:
      - name: "Framework for Open and Reproducible Research Training (FORRT)"
    doi: "10.17605/OSF.IO/9R62X"
    url: "https://github.com/forrtproject/FReD-data"
    license: CC-BY-4.0
    notes: "Bundled as a converted snapshot (dist/data/flora-replications.json); see NOTICE."
